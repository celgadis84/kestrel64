# Build trees
build/
build-*/
out/
CMakeFiles/
CMakeCache.txt

# ROMs and dumps (never commit copyrighted images)
*.z64
*.n64
*.v64
*.N64

# Scratch artifacts from debug/capture sessions
*.bmp
*.png
*.log
*.out
*.err
*.pyc
__pycache__/

# Editor / OS
.vscode/
.idea/
Thumbs.db
desktop.ini

# scratch de depuración en la raíz (volcados de log de sesiones)
/*.txt
!requirements*.txt
!THIRD-PARTY.txt
build-prof/
build-prof-prdp/

# lanzador: estado local del usuario, no del repo
tools/launcher/cache/
tools/launcher/profile.json
tools/launcher/pad1.cfg

# Empaquetado (scripts/dist.sh): salida derivada del build, se regenera.
dist/
kestrel64-*-win64.zip
kestrel64-*-setup.exe

# marcas de tiempo de los gates
/.gate_t*

# notas locales de sesion
scratchpad/

# Huellas de los ficheros publicados (scripts/publish.py), se regeneran.
SHA256SUMS.txt
