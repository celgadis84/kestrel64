# Configuracion local de la maquina. Copiar a scripts/local.env (ignorado por git) y ajustar.
# Formato KEY="valor", una por linea. Una variable de entorno con el mismo nombre manda sobre
# lo que diga este fichero. Las ROMs NO van en el repo: cada uno pone aqui las suyas.

# Interprete de python para los scripts .sh (por defecto, `python` del PATH).
PY="python"

# Carpeta de ROMs de prueba (systemtest, krom, homebrew...). Por defecto, ../test_roms.
KESTREL_TESTROMS="../test_roms"

# ROMs concretas que usan validate.py, bench.sh, pgo.sh y los *_smoke.py. Ruta absoluta o
# relativa a KESTREL_TESTROMS. Vacia = la prueba que la necesita se salta o pide --rom.
ROM_SM64=""
ROM_DK64=""
ROM_PD=""

# Ejecutable de ares para scripts/fidelity.py (opcional).
ARES_EXE=""
