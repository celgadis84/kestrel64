  int sw0 = foldS(tl, s0), sw1 = foldS(tl, s0 + 1), tw0 = foldT(tl, t0), tw1 = foldT(tl, t0 + 1);
  uint c10 = fetch(tl, sw1, tw0), c01 = fetch(tl, sw0, tw1);
  bool midTexel = ((U(R_OHI) >> 12) & 1u) != 0u && fx == 16 && fy == 16;
  int o[4];
  if(midTexel) {
    uint c00 = fetch(tl, sw0, tw0), c11 = fetch(tl, sw1, tw1);
    for(int i = 0; i < 4; i++) o[i] = (ch(c00, i) + ch(c10, i) + ch(c01, i) + ch(c11, i) + 2) >> 2;
  } else {
    bool upper = fx + fy >= 32;
    uint bc = upper ? fetch(tl, sw1, tw1) : fetch(tl, sw0, tw0);
    int wx = upper ? 32 - fy : fx, wy = upper ? 32 - fx : fy;
    for(int i = 0; i < 4; i++) {
      int b = ch(bc, i);
      o[i] = (((ch(c10, i) - b) * wx + (ch(c01, i) - b) * wy + 0x10) >> 5) + b;
    }
