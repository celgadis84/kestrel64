  uint s = uint(si), t = uint(ti);
  uint ox = (t & 1u) != 0u ? (kind == TK_RGBA32 ? 8u : 4u) : 0u;
  uint row = base + t * rowBytes;
  if(kind == TK_CI4 || kind == TK_IA4 || kind == TK_I4) {
    uint off = (row + s / 2u) ^ ox;
    if(off >= 0x1000u) return 0u;
    uint nib = (s & 1u) != 0u ? (tmB(off) & 0xfu) : (tmB(off) >> 4);
    if(kind == TK_CI4) return tlutEntry(pal * 16u + nib);
    if(kind == TK_IA4) { uint i = (((nib >> 1) & 7u) * 255u) / 7u, a = (nib & 1u) != 0u ? 255u : 0u;
