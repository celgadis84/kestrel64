  }
  if(kind == TK_CI8 || kind == TK_IA8 || kind == TK_I8) {
    uint off = (row + s) ^ ox;
    if(off >= 0x1000u) return 0u;
    uint v = tmB(off);
    if(kind == TK_CI8) return tlutEntry(v);
    if(kind == TK_IA8) { uint i = (v >> 4) * 17u, a = (v & 0xfu) * 17u;
                         return (i << 24) | (i << 16) | (i << 8) | a; }
