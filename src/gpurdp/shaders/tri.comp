    if((fl & F_ACMP) != 0) {   // alphaRef >= umbral de blend_color
      int a = int(c & 0xffu);
      if((U(R_OLO) & 0x2000u) == 0u) a = min(a + ((a + 1) >> 8) + alphaDither(x, y), 255);
      if(a < int(U(R_BLEND) & 0xffu)) {
        if(combProg && pc.sh == 0u && x == R(R_LASTX) && y == R(R_LASTY)) {
          int o = int(cur) * 8;
          outv[o + 2] = comb[0]; outv[o + 3] = comb[1]; outv[o + 4] = comb[2]; outv[o + 5] = comb[3];
        }
        return;
      }
    }
  } else if(gouraud) {
    gTex1 = 0u;
    c = combProg ? combine(0u, shd, comb) : shd;
    pxShadeA = min(int(shd & 0xffu) + alphaDither(x, y), 0xff);
  } else {
    gTex1 = U(R_FTEX);
    c = combProg ? combine(U(R_FTEX), 0u, comb) : U(R_FLAT);
    pxShadeA = alphaDither(x, y);
  }
  // El ultimo pixel cubierto (orden de recorrido) deja COMBINED para la primitiva siguiente.
  if(combProg && pc.sh == 0u && x == R(R_LASTX) && y == R(R_LASTY)) {
    int o = int(cur) * 8;
    outv[o + 2] = comb[0]; outv[o + 3] = comb[1]; outv[o + 4] = comb[2]; outv[o + 5] = comb[3];
  }
  blendPixel(x, y, c, hits, hasZ, zin, pxShadeA);
}

// TEXTURE_RECTANGLE (SoftRdp::texRect). R_TC: S y T de arranque ya escalados, R_TDX: DsDx
// y DtDy, R_TDE: XH/YH (en cuartos) contra los que corren. S en 1/4096 de texel (1/16384 en
// COPY, donde DsDx va x4), T en 1/4096. FLIP cruza los ejes. Sin shade ni z.
// d * q / S con suelo y sin desbordar: q = S*f + r.
int rstep(int d, int q) {
  if(pc.sh == 0u) return d * q;
  int f = q >> int(pc.sh), rr = q & (SC - 1);
  return d * f + ((d * rr) >> int(pc.sh));
}
void rectPixel(int x, int y) {
  int fl = R(R_FLAGS);
  bool flip = (fl & F_FLIP) != 0, copy = (fl & F_COPY) != 0;
  int ns = R(R_TC) + rstep(R(R_TDX), 4 * (flip ? y : x) - SC * R(R_TDE));
  int nt = R(R_TC + 1) + rstep(R(R_TDX + 1), 4 * (flip ? x : y) - SC * R(R_TDE + 1));
  int shS = copy ? 14 : 12;
  int tl = int(U(R_TINFO) & 7u);
  uint tex = rectSample(tl, ns, nt, shS);
  gTex1 = (fl & F_TEX1) != 0 ? rectSample((tl + 1) & 7, ns, nt, shS) : tex;
  gLod = R(R_LOD);
  ivec4 comb = ivec4(0);
  bool combProg = (fl & F_COMB) != 0;
  uint c = combProg ? combine(tex, 0u, comb) : tex;
  if(combProg && pc.sh == 0u && x == R(R_LASTX) && y == R(R_LASTY)) {
    int o = int(cur) * 8;
    outv[o + 2] = comb[0]; outv[o + 3] = comb[1]; outv[o + 4] = comb[2]; outv[o + 5] = comb[3];
  }
  if((fl & F_ACMP) != 0) {
    if(copy) { if((c & 0xffu) == 0u) return; }
    else {
      int a = int(c & 0xffu);
      if((U(R_OLO) & 0x2000u) == 0u) a = min(a + ((a + 1) >> 8) + alphaDither(x, y), 255);
      if(a < int(U(R_BLEND) & 0xffu)) return;
    }
  }
  if((U(R_OLO) & 0x40u) != 0u) blendPixel(x, y, c, 8, false, 0, 0);
  else if(x >= R(R_SX0) * SC && x < R(R_SX1) * SC && y >= R(R_SY0) * SC && y < R(R_SY1) * SC) storePixel(x, y, c);
}

shared uint sHit[64];

// Caja de la primitiva en la resolucion en curso. En alta un triangulo se ensancha un pixel de
// 1x por lado: la caja de 1x es la de los pixeles con alguna muestra de 1x dentro, y en alta
// hay muestras cubiertas en el pixel vecino (sin esto salen rendijas entre triangulos que
// comparten borde). Los bordes y el scissor siguen recortando; el texrect no tiene bordes.
ivec4 boxOf(int b) {
  int bx = rec[b + R_BX], by = rec[b + R_BY], bw = rec[b + R_BW], bh = rec[b + R_BH];
  if(pc.sh != 0u && (rec[b + R_FLAGS] & F_RECT) == 0 && bw > 0 && bh > 0) {
    bx -= 1; by -= 1; bw += 2; bh += 2;
  }
  return ivec4(bx, by, bw, bh) * SC;
}

void main() {
  SC = 1 << int(pc.sh);
  const uint lid = gl_LocalInvocationIndex;
  const int tx = pc.ux + int(gl_WorkGroupID.x) * 8, ty = pc.uy + int(gl_WorkGroupID.y) * 8;
  const int x = tx + int(gl_LocalInvocationID.x), y = ty + int(gl_LocalInvocationID.y);
  const bool inU = x < pc.ux + pc.uw && y < pc.uy + pc.uh;
  for(uint c0 = 0u; c0 < pc.count; c0 += 64u) {
    // Criba: cada hilo mira una primitiva del trozo contra la tesela entera.
    uint hit = 0u;
    if(c0 + lid < pc.count) {
      ivec4 bb = boxOf(int(pc.idx + c0 + lid) * R_SIZE);
      int bx = bb.x, by = bb.y, bw = bb.z, bh = bb.w;
      if(bw > 0 && bh > 0 && bx < tx + 8 && tx < bx + bw && by < ty + 8 && ty < by + bh) hit = 1u;
    }
    sHit[lid] = hit;
    barrier();
    const uint n = min(64u, pc.count - c0);
    for(uint j = 0u; j < n; j++) {
      if(sHit[j] == 0u || !inU) continue;
      cur = pc.idx + c0 + j;
      base = int(cur) * R_SIZE;
      ivec4 bb = boxOf(base);
      if(x < bb.x || x >= bb.x + bb.z || y < bb.y || y >= bb.y + bb.w) continue;
      tbase = U(R_TSLOT) * 1152u;
      nWrite = 0; nZWrite = 0;
      if((R(R_FLAGS) & F_RECT) != 0) rectPixel(x, y);
      else pixel(x, y);
      if(pc.sh != 0u) continue;
      if(nWrite != 0)  atomicAdd(outv[int(cur) * 8 + 0], nWrite);
      if(nZWrite != 0) atomicAdd(outv[int(cur) * 8 + 1], nZWrite);
    }
    barrier();
  }
}
