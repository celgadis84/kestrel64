// --- textura (SoftRdp::foldOf / foldCoord / fetchK / filterK / lodSelect, perspDivide) ------
uint tbase;   // primera palabra de la ranura de TMEM del triangulo
uint tmB(uint off) { return (tm[tbase + (off >> 2)] >> ((off & 3u) * 8u)) & 0xffu; }
uint exp5(uint v) { return (v << 3) | (v >> 2); }
uint tlutEntry(uint idx) {
  uint j = idx & 0xffu;
  uint e = (tm[tbase + 1024u + (j >> 1)] >> ((j & 1u) * 16u)) & 0xffffu;
  if(((U(R_OHI) >> 14) & 3u) == 3u) { uint i = (e >> 8) & 0xffu, a = e & 0xffu;
                                       return (i << 24) | (i << 16) | (i << 8) | a; }
  uint r = exp5((e >> 11) & 0x1fu), g = exp5((e >> 6) & 0x1fu), b = exp5((e >> 1) & 0x1fu);
  return (r << 24) | (g << 16) | (b << 8) | ((e & 1u) != 0u ? 255u : 0u);
}
// Tile t: palabra 0 = shiftS | shiftT << 4 | maskS << 8 | maskT << 12 | cmS << 16 | cmT << 18 |
// kind << 20 | palette << 24; luego sMax, tMax, bytes por fila y base en TMEM.
const uint TK_CI4 = 0u, TK_IA4 = 1u, TK_I4 = 2u, TK_YUV = 3u, TK_IA16 = 4u, TK_RGBA16 = 5u,
           TK_RGBA32 = 6u, TK_CI8 = 7u, TK_IA8 = 8u, TK_I8 = 9u;
int foldCoord(int c, uint sh, uint mask, uint cm, int lim) {
  if(sh != 0u) c = sh <= 10u ? (c >> int(sh)) : (c << int(16u - sh));
  if((cm & 2u) != 0u || mask == 0u) {
    if(c < 0) c = 0;
    else if(lim >= 0 && c > lim) c = lim;
  }
  if(mask != 0u) {
    if((cm & 1u) != 0u && ((c >> int(mask)) & 1) != 0) c = ~c;
    c &= (1 << int(mask)) - 1;
  }
  return c;
}
int foldS(int tl, int c) { uint w = U(R_TILES + tl * 5);
  return foldCoord(c, w & 15u, (w >> 8) & 15u, (w >> 16) & 3u, R(R_TILES + tl * 5 + 1)); }
int foldT(int tl, int c) { uint w = U(R_TILES + tl * 5);
  return foldCoord(c, (w >> 4) & 15u, (w >> 12) & 15u, (w >> 18) & 3u, R(R_TILES + tl * 5 + 2)); }
uint fetch(int tl, int si, int ti) {
