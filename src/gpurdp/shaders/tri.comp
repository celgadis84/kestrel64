}

// --- recorrido de bordes y pixel (SoftRdp::drawTriangle) ----------------------------------
int quant(int x) { x = sext(uint(x), 27 + int(pc.sh)); return (x >> 12) | ((x & 0xfff) != 0 ? 1 : 0); }

void pixel(int x, int y) {
