#version 450
// GPU-RDP fases 1-2: triangulo (FILL, shade, plano o con textura) en 16 bpp con cobertura, z y
// blender. Fase 2: muestreo de TMEM (todos los formatos, TLUT, pliegue clamp/mirror/mask,
// filtro de 3 puntos, perspectiva, LOD/mipmap, TEXEL1 en 2 ciclos) y alpha compare.
// Fase 4: TEXTURE_RECTANGLE (y FLIP) en 1/2 ciclos y COPY, mismo registro con F_RECT.
// Semantica = SoftRdp::drawTriangle + blendPixel + blendColor + combineColor, bit a
// bit (rdp.cpp es la referencia; cada bloque de abajo nombra su funcion). Un hilo por pixel
// de la caja que el CPU ya midio al cobrar el triangulo; cada hilo rehace el recorrido de
// bordes de su fila (es barato y asi no hay datos por fila que subir).
//
// Fase 5: un despacho por TRAMO de primitivas consecutivas con la misma color image y z image
// (registros pc.idx .. pc.idx+pc.count-1). Workgroup = tesela de 8x8 pixeles sobre la caja
// union del tramo (pc.ux/uy/uw/uh). La tesela criba en memoria compartida que cajas la tocan,
// y cada hilo recorre SU pixel por todas las primitivas del tramo en el orden del FIFO: el
// orden por pixel es el de SoftRDP sin una sola barrera entre primitivas. Dos pixeles distintos
// no comparten media palabra ni de color ni de z (el CPU corta el tramo si color y z se cruzan).
//
// Fase 6 (escalado interno, pc.sh != 0): MISMO shader en una segunda pasada a S = 2^sh veces la
// resolucion, con los buffers 0/1 cambiados por los de alta resolucion. Cada pixel de 1x es un
// bloque contiguo de SxS pixeles (hiAddr = a1x * S^2 + (j*S + i) * bpp), asi que las huellas
// disjuntas de 1x siguen disjuntas aqui y valen las mismas barreras. Bordes en coordenadas de
// alta (X de arranque y Y por S, pendientes iguales), atributos con los deltas / S, LOD con los
// deltas de 1x (mismo mip que 1x). Esta pasada no escribe resultados: la contabilidad y lo que
// vuelve a la RDRAM son de la pasada de 1x, que sigue siendo la autoridad.
//
// Dentro de un triangulo dos pixeles nunca tocan la misma media palabra (ni de color ni de z:
// el CPU solo manda aqui triangulos con x < ancho y zonas de color y z separadas), asi que no
// hay orden que respetar entre hilos. Las medias palabras comparten palabra de 32 bits con el
// vecino: se escriben con atomicAnd/atomicOr sobre su mitad y nunca pisan la otra.
//
// Espejo de RDRAM: byte de la direccion 4w+i en los bits 8*i de ram[w] (orden del anfitrion).
// Bits ocultos: un byte por media palabra, mismo empaquetado en hid[].
// TMEM: una instantanea por triangulo con textura (la que habia al rasterizarlo): 4 KB de TMEM
// y luego 256 entradas de 16 bits de TLUT, 1152 palabras por ranura, bytes en orden del anfitrion.
layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, binding = 0) buffer Ram { uint ram[]; };
layout(std430, binding = 1) buffer Hid { uint hid[]; };
layout(std430, binding = 2) readonly buffer Recs { int rec[]; };
layout(std430, binding = 3) readonly buffer Lut { uint lut[]; };   // divisor del blender, 32 KB
layout(std430, binding = 4) buffer Outs { int outv[]; };
layout(std430, binding = 5) readonly buffer Tmem { uint tm[]; };
// sh en el desplazamiento 44, como en fill.comp (gpurdp.cpp Push::sh).
layout(push_constant) uniform P { uint idx; uint count; int ux; int uy; int uw; int uh;
                                  uint p6; uint p7; uint p8; uint p9; uint p10; uint sh; } pc;

// Disposicion del registro (debe casar con gpurdp.hpp TriRec, en palabras de 32 bits).
const int R_YL = 0, R_YM = 1, R_YH = 2, R_XL = 3, R_DXL = 4, R_XH = 5, R_DXH = 6, R_XM = 7,
          R_DXM = 8, R_FLAGS = 9, R_SX0 = 10, R_SY0 = 11, R_SX1 = 12, R_SY1 = 13,
          R_BX = 14, R_BY = 15, R_BW = 16, R_BH = 17,
          R_CC = 18, R_CDX = 22, R_CDE = 26, R_CDY = 30,
          R_Z = 34, R_ZDX = 35, R_ZDE = 36, R_ZDY = 37,
          R_CI = 38, R_CIW = 39, R_ZI = 40, R_OLO = 41, R_OHI = 42,
          R_FILL = 43, R_PRIM = 44, R_ENV = 45, R_BLEND = 46, R_FOG = 47, R_FLAT = 48, R_FTEX = 49,
          R_SEL = 50,   // 4 palabras: sel[2][8] en bytes
          R_LOD = 54, R_PLOD = 55, R_PZ = 56, R_PDZ = 57, R_PDZC = 58, R_LASTX = 59, R_LASTY = 60,
          // Textura: S, T, (Z), W como los atributos de color; tile base | nivel maximo << 4 |
          // prim_min_level << 8; SET_CONVERT k0..k3; ranura de TMEM; 8 tiles de 5 palabras.
          R_TC = 64, R_TDX = 68, R_TDE = 72, R_TDY = 76, R_TINFO = 80, R_K0 = 81, R_TSLOT = 85, R_CISZ = 86,
          R_TILES = 88,
          R_SIZE = 128;
// FLAGS
const int F_LEFT = 1, F_DOOFF = 2, F_FILL = 4, F_SHADE = 8, F_ZACT = 16, F_ZSRC = 32, F_AA = 64,
          F_COMB = 128, F_NOBLEND = 256, F_TWO = 512, F_NOAAGLB = 1024, F_TEX = 2048,
          F_PERSP = 4096, F_LOD = 8192, F_TEX1 = 16384, F_FILT = 32768, F_ACMP = 65536,
          F_RECT = 131072, F_FLIP = 262144, F_COPY = 524288;

int base;
uint cur;   // registro de la primitiva en curso
int R(int i) { return rec[base + i]; }
uint U(int i) { return uint(rec[base + i]); }

int SC;   // 1 << pc.sh
// Direccion del pixel (x, y) de una imagen de `bpp` bytes por pixel con base `b`: en 1x la de
// la RDRAM; en alta, la del bloque SxS de su pixel de 1x.
uint pa(uint b, int x, int y, uint bpp) {
  if(pc.sh == 0u) return b + (uint(y) * U(R_CIW) + uint(x)) * bpp;
  uint m = uint(SC - 1);
  uint a1 = b + (uint(y >> int(pc.sh)) * U(R_CIW) + uint(x >> int(pc.sh))) * bpp;
  return (a1 << (2u * pc.sh)) + (((uint(y) & m) << pc.sh) + (uint(x) & m)) * bpp;
}
int D(int i) { return R(i) >> int(pc.sh); }   // delta por pixel de la resolucion en curso

int sext(uint v, int bits) { return int(v << (32 - bits)) >> (32 - bits); }
int s16(int v) { return (v << 16) >> 16; }

// --- RDRAM -----------------------------------------------------------------------------
uint rd8(uint a) { return (ram[a >> 2] >> ((a & 3u) * 8u)) & 0xffu; }
uint rd16(uint a) { return (rd8(a) << 8) | rd8(a + 1u); }
void wr16(uint a, uint v) {   // a par: los dos bytes caen en la misma palabra
  uint sh = (a & 3u) * 8u;
  uint bytes = ((v >> 8) & 0xffu) | ((v & 0xffu) << 8);
  atomicAnd(ram[a >> 2], ~(0xffffu << sh));
  atomicOr(ram[a >> 2], bytes << sh);
}
void wr8(uint a, uint v) {
  uint sh = (a & 3u) * 8u;
  atomicAnd(ram[a >> 2], ~(0xffu << sh));
  atomicOr(ram[a >> 2], (v & 0xffu) << sh);
}
uint rdHid(uint e) { return (hid[e >> 2] >> ((e & 3u) * 8u)) & 0xffu; }
void wrHid(uint e, uint v) {
  uint sh = (e & 3u) * 8u;
  atomicAnd(hid[e >> 2], ~(0xffu << sh));
  atomicOr(hid[e >> 2], (v & 0xffu) << sh);
}

// --- z comprimido (SoftRdp::zEncode / zDecode) -------------------------------------------
const uint zBase[8]  = uint[8](0u, 0x20000u, 0x30000u, 0x38000u, 0x3c000u, 0x3e000u, 0x3f000u, 0x3f800u);
const uint zShift[8] = uint[8](6u, 5u, 4u, 3u, 2u, 1u, 0u, 0u);
uint zEncode(uint z) {
  if(z > 0x3ffffu) z = 0x3ffffu;
  int e = 0;
  while(e < 7 && z >= zBase[e + 1]) e++;
  uint mant = (z - zBase[e]) >> zShift[e];
  return (((uint(e) << 11) | (mant & 0x7ffu)) << 2) & 0xffffu;
}
uint zDecode(uint m) {
  uint com = (m >> 2) & 0x3fffu;
  uint e = (com >> 11) & 7u;
  return ((com & 0x7ffu) << zShift[e]) + zBase[e];
}

// --- dither (SoftRdp::ditherRgb / alphaDither) --------------------------------------------
const int kDith[32] = int[32](0, 6, 1, 7, 4, 2, 5, 3, 3, 5, 2, 4, 7, 1, 6, 0,
                              0, 4, 1, 5, 4, 0, 5, 1, 3, 7, 2, 6, 7, 3, 6, 2);
uint noiseHash(int x, int y, uint i) {
  uint h = uint(x) * 0x9e3779b1u ^ uint(y) * 0x85ebca6bu ^ i * 0xc2b2ae35u;
  h ^= h >> 15; h *= 0x2545f491u; h ^= h >> 13;
  return h & 7u;
}
uint ditherRgb(int x, int y, uint c) {
  uint mode = (U(R_OHI) >> 6) & 3u;
  if(mode == 3u) return c;
  uint o = c & 0xffu;
  for(uint i = 0u; i < 3u; i++) {
    int v = int((c >> (24u - i * 8u)) & 0xffu);
    int d = mode < 2u ? kDith[int(mode) * 16 + (y & 3) * 4 + (x & 3)] : int(noiseHash(x, y, i));
    if((v & 7) > d) v = v > 247 ? 255 : (v & 0xf8) + 8;
    o |= uint(v) << (24u - i * 8u);
  }
  return o;
}
int alphaDither(int x, int y) {
  uint am = (U(R_OHI) >> 4) & 3u, rm = (U(R_OHI) >> 6) & 3u;
  if(am == 3u) return 0;
  if(am == 2u) return int(noiseHash(x, y, 3u));
  int d = kDith[int(rm & 1u) * 16 + (y & 3) * 4 + (x & 3)];
  return am == 1u ? (~d & 7) : d;
}

// --- combinador (SoftRdp::combineColor, camino escalar) -----------------------------------
// Filas: CIN, TEX0, TEX1, PRIM, SHADE, ENV, CINA, TEX0A, TEX1A, PRIMA, SHADEA, ENVA, ONE, ZERO,
// LOD, PLOD. COMBINED del primer ciclo no llega aqui (el CPU no manda triangulos que lo lean);
// en 2 ciclos el del segundo es el resultado crudo del primero. El cruce de texels del segundo
// ciclo ya viene en los selectores (buildCombPlan).
int ch(uint c, int i) { return int((c >> (24 - i * 8)) & 0xffu); }
uint gTex1;    // TEXEL1 del pixel (en 1 ciclo, el mismo TEXEL0)
int gLod;      // LOD_FRAC del pixel
int rowVal(uint r, int i, uint tex, uint shade, ivec4 cin) {
  switch(r) {
    case 0u: return cin[i];
    case 1u: return ch(tex, i);
    case 2u: return ch(gTex1, i);
    case 3u: return ch(U(R_PRIM), i);
    case 4u: return ch(shade, i);
    case 5u: return ch(U(R_ENV), i);
    case 6u: return cin[3];
    case 7u: return int(tex & 0xffu);
    case 8u: return int(gTex1 & 0xffu);
    case 9u: return int(U(R_PRIM) & 0xffu);
    case 10u: return int(shade & 0xffu);
    case 11u: return int(U(R_ENV) & 0xffu);
    case 12u: return 0x100;
    case 14u: return gLod;
    case 15u: return R(R_PLOD);
    default: return 0;
  }
}
uint selOf(int cyc, int k) { int b = cyc * 8 + k; return (U(R_SEL + (b >> 2)) >> ((b & 3) * 8)) & 0xffu; }
int sexp(int v) { int x = (v - 0x80) & 0x1ff; if((x & 0x100) != 0) x |= ~0x1ff; return x + 0x80; }
int eq(int a, int b, int c, int d) { a = sexp(a); b = sexp(b); d = sexp(d); return (((a - b) * c + 0x80) >> 8) + d; }
ivec4 runCycle(int cyc, uint tex, uint shade, ivec4 cin) {
  ivec4 o;
  for(int i = 0; i < 3; i++)
    o[i] = eq(rowVal(selOf(cyc, 0), i, tex, shade, cin), rowVal(selOf(cyc, 1), i, tex, shade, cin),
              rowVal(selOf(cyc, 2), i, tex, shade, cin), rowVal(selOf(cyc, 3), i, tex, shade, cin));
  o[3] = eq(rowVal(selOf(cyc, 4), 3, tex, shade, cin), rowVal(selOf(cyc, 5), 3, tex, shade, cin),
            rowVal(selOf(cyc, 6), 3, tex, shade, cin), rowVal(selOf(cyc, 7), 3, tex, shade, cin));
  return o;
}
// Devuelve el RGBA y deja en `comb` el registro COMBINED tal como lo latchea el CPU.
uint combine(uint tex, uint shade, out ivec4 comb) {
  ivec4 fin;
  if((R(R_FLAGS) & F_TWO) != 0) fin = runCycle(1, tex, shade, runCycle(0, tex, shade, ivec4(0)));
  else                          fin = runCycle(1, tex, shade, ivec4(0));
  for(int i = 0; i < 4; i++) { int x = sexp(fin[i]); comb[i] = x < 0 ? 0 : x > 255 ? 255 : x; }
  uint rgba = (uint(comb[0]) << 24) | (uint(comb[1]) << 16) | (uint(comb[2]) << 8) | uint(comb[3]);
  comb[3] += (comb[3] + 1) >> 8;
  return rgba;
}

// --- blender (SoftRdp::blendColor) --------------------------------------------------------
uint pickC(uint sel, uint src, uint memc) {
  return sel == 0u ? src : sel == 1u ? memc : sel == 2u ? U(R_BLEND) : U(R_FOG);
}
uint blendColor(uint src, uint memc, bool blendEn, bool cvgWrap, int shA, int shB, int pxShadeA) {
  uint olo = U(R_OLO);
  bool two = (R(R_OHI) >> 20 & 3) == 1;
  int sh = two ? 0 : 2;
  uint psel = (olo >> (28 + sh)) & 3u, asel = (olo >> (24 + sh)) & 3u;
  uint msel = (olo >> (20 + sh)) & 3u, bsel = (olo >> (16 + sh)) & 3u;
  if(two) {
    uint P0 = pickC((olo >> 30) & 3u, src, memc), M0 = pickC((olo >> 22) & 3u, src, memc);
    uint as0 = (olo >> 26) & 3u, bs0 = (olo >> 18) & 3u;
    int b0 = as0 == 0u ? int(src & 0xffu) : as0 == 1u ? int(U(R_FOG) & 0xffu) : as0 == 2u ? pxShadeA : 0;
    int b1 = bs0 == 0u ? ((~b0) & 0xff) : bs0 == 1u ? int(memc & 0xffu) : bs0 == 2u ? 0xff : 0;
    b0 >>= 3; b1 >>= 3;
    if(bs0 == 1u) { b0 = (b0 >> shA) & 0x3c; b1 = (b1 >> shB) | 3; }
    uint c0 = src & 0xffu;
    for(int i = 0; i < 3; i++) {
      int s = 24 - i * 8;
      int v = (int((P0 >> s) & 0xffu) * b0 + int((M0 >> s) & 0xffu) * (b1 + 1)) >> 5;
      c0 |= uint(v & 0xff) << s;
    }
    src = c0;
  }
  uint P = pickC(psel, src, memc), M = pickC(msel, src, memc);
  bool colorOnCvg = (olo & 0x80u) != 0u;
  if(colorOnCvg && !cvgWrap) return (M & ~0xffu) | (src & 0xffu);
  int a0 = asel == 0u ? int(src & 0xffu) : asel == 1u ? int(U(R_FOG) & 0xffu) : asel == 2u ? pxShadeA : 0;
  if(!blendEn || (asel == 0u && bsel == 0u && (src & 0xffu) == 0xffu)) return (P & ~0xffu) | (src & 0xffu);
  int a1 = bsel == 0u ? ((~a0) & 0xff) : bsel == 1u ? int(memc & 0xffu) : bsel == 2u ? 0xff : 0;
  a0 >>= 3; a1 >>= 3;
  if(bsel == 1u) { a0 = (a0 >> shA) & 0x3c; a1 = (a1 >> shB) | 3; }
  bool force = ((olo >> 14) & 1u) != 0u;
  int sum = (a0 >> 2) + (a1 >> 2) + 1;
  uint o = 0u;
  for(int i = 0; i < 3; i++) {
    int blended = ch(P, i) * a0 + ch(M, i) * (a1 + 1);
    int v;
    if(force) v = (blended >> 5) & 0xff;
    else {
      uint li = (uint(sum) << 11) | (uint(blended >> 2) & 0x7ffu);
      v = int((lut[li >> 2] >> ((li & 3u) * 8u)) & 0xffu);
    }
    o |= uint(v) << (24 - i * 8);
  }
  return o | (src & 0xffu);
}

// --- escritura (SoftRdp::storePixel 16 bpp, depthTest, blendPixel) -------------------------
int nWrite = 0, nZWrite = 0;
uint to5551(uint c) {
  uint r = (c >> 24) & 0xffu, g = (c >> 16) & 0xffu, b = (c >> 8) & 0xffu, a = c & 0xffu;
  return ((r >> 3) << 11) | ((g >> 3) << 6) | ((b >> 3) << 1) | ((a >> 7) & 1u);
}
// Color image de 8 bits (byte bajo) o 32 bits (RGBA8888 tal cual), como SoftRdp::storePixel.
void storePixel(int x, int y, uint rgba) {
  nWrite++;
  if(R(R_CISZ) == 3) {   // ci_addr alineada a 4: la palabra entera es del pixel
    uint a = pa(U(R_CI), x, y, 4u);
    ram[a >> 2] = (rgba >> 24) | ((rgba >> 8) & 0xff00u) | ((rgba << 8) & 0xff0000u) | (rgba << 24);
    return;
  }
  if(R(R_CISZ) == 1) { wr8(pa(U(R_CI), x, y, 1u), rgba); return; }
  uint a = pa(U(R_CI), x, y, 2u);
  wr16(a, to5551(rgba));
  wrHid(a >> 1, (rgba >> 5) & 3u);
}
bool depthTest(int x, int y, int d) {
  if(d < 0) d = 0; else if(d > 0x3ffff) d = 0x3ffff;
  uint zoff = pa(U(R_ZI), x, y, 2u);
  uint old = zDecode(rd16(zoff));
  uint olo = U(R_OLO);
  if((olo & 0x10u) != 0u && uint(d) >= old) return false;
  if((olo & 0x20u) != 0u) { wr16(zoff, zEncode(uint(d))); nZWrite++; }
  return true;
}
uint readFb(int x, int y) {
  if(R(R_CISZ) == 3) {
    uint a = pa(U(R_CI), x, y, 4u);
    return (rd8(a) << 24) | (rd8(a + 1u) << 16) | (rd8(a + 2u) << 8) | rd8(a + 3u);
  }
  if(R(R_CISZ) == 1) { uint v = rd8(pa(U(R_CI), x, y, 1u)); return v * 0x01010101u; }
  uint a = pa(U(R_CI), x, y, 2u);
  uint px = rd16(a);
  uint r = ((px >> 11) & 0x1fu) << 3, g = ((px >> 6) & 0x1fu) << 3, b = ((px >> 1) & 0x1fu) << 3;
  uint al = ((((px & 1u) << 2) | (rdHid(a >> 1) & 3u)) << 5);
  return (r << 24) | (g << 16) | (b << 8) | al;
}

void blendPixel(int x, int y, uint src, int cvg, bool hasZ, int zin, int pxShadeA) {
  if(x < R(R_SX0) * SC || x >= R(R_SX1) * SC || y < R(R_SY0) * SC || y >= R(R_SY1) * SC || x < 0 || y < 0) return;
  uint olo = U(R_OLO), ohi = U(R_OHI);
  int fl = R(R_FLAGS);
  // Plan del blender (SoftRdp::buildBlendPlan).
  bool two = ((ohi >> 20) & 3u) == 1u;
  int sh = two ? 0 : 2;
  uint psel = (olo >> (28 + sh)) & 3u, msel = (olo >> (20 + sh)) & 3u, bsel = (olo >> (16 + sh)) & 3u;
  bool usesMem = msel == 1u || bsel == 1u ||
                 (two && (((olo >> 30) & 3u) == 1u || ((olo >> 22) & 3u) == 1u || ((olo >> 18) & 3u) == 1u));
  bool imRd = (olo & 0x40u) != 0u;
  bool force = ((olo >> 14) & 1u) != 0u;
  bool aaEn = (olo & 0x08u) != 0u && (fl & F_NOAAGLB) == 0;
  uint cvgDst = (olo >> 8) & 3u;
  bool colorOnCvg = (olo & 0x80u) != 0u, cvgXAlpha = ((olo >> 12) & 1u) != 0u;
  bool alphaCvgSel = ((olo >> 13) & 1u) != 0u;
  bool needMem = usesMem || colorOnCvg || aaEn || cvgDst != 2u || (olo & 0x10u) != 0u;
  if((fl & F_NOBLEND) != 0) {
    if(hasZ && !depthTest(x, y, zin)) return;
    storePixel(x, y, src); return;
  }
  if(usesMem && !imRd) {
    if(hasZ && !depthTest(x, y, zin)) return;
    storePixel(x, y, ditherRgb(x, y, src)); return;
  }
  uint memc = 0u; int memCvg = 7;
  if(imRd && needMem) { memc = readFb(x, y); memCvg = int((memc & 0xffu) >> 5); }
  {
    int a = int(src & 0xffu);
    int expanded = a + ((a + 1) >> 8);
    int modulated;
    if(cvgXAlpha) { modulated = (expanded * cvg + 4) >> 3; cvg = modulated >> 5; }
    else          { modulated = cvg << 5; }
    if(alphaCvgSel) expanded = modulated;
    else            expanded += alphaDither(x, y);
    src = (src & ~0xffu) | uint(expanded < 0 ? 0 : expanded > 255 ? 255 : expanded);
  }
  if(aaEn && cvg == 0) return;
  bool zCmp = hasZ && (olo & 0x10u) != 0u, zUpd = hasZ && (olo & 0x20u) != 0u;
  uint zoff = 0u; int zz = 0;
  int pxDz = R(R_PDZ), pxDzC = R(R_PDZC);
  if(hasZ) {
    zoff = pa(U(R_ZI), x, y, 2u);
    zz = clamp(zin, 0, 0x3ffff);
  }
  bool overflow = (cvg + memCvg) >= 8;
  bool blendEn;
  int shA = 0, shB;
  if(zCmp) {
    uint zw = rd16(zoff);
    int memZ = int(zDecode(zw));
    int memDzC = int(((zw & 3u) << 2) | (rdHid(zoff >> 1) & 3u));
    int memDz = 1 << memDzC;
    int prec = int((zw >> 13) & 7u);
    shA = clamp(pxDzC - memDzC, 0, 4);
    shB = clamp(memDzC - pxDzC, 0, 4);
    bool coplanar = false;
    if(prec < 3) {
      if(memDz != 0x8000) memDz = max(memDz << 1, 16 >> prec);
      else { coplanar = true; memDz = 0xffff; }
    }
    int cdz = pxDz | memDz;
    cdz = cdz != 0 ? 1 << findMSB(uint(cdz)) : 0;
    int cdzI = cdz;
    cdz <<= 3;
    bool farther = coplanar || zz + cdz >= memZ;
    blendEn = force || (!overflow && aaEn && farther);
    bool maxZ = memZ == 0x3ffff, front = zz < memZ;
    bool nearer = coplanar || zz - cdz <= memZ;
    bool pass;
    switch((olo >> 10) & 3u) {
      case 0u: pass = maxZ || (overflow ? front : nearer); break;
      case 1u:
        if(!front || !farther || !overflow) pass = maxZ || (overflow ? front : nearer);
        else {
          int c = (cdzI & 0xffff) != 0 ? findMSB(uint(cdzI & 0xffff)) : 0;
