// Texrect: S y T en 1/2^sh de texel. Sin filtro el texel de floor; con filtro, S/T a 1/32
// redondeados con el empate lejos del cero (lroundExact de SoftRdp::filterK).
int rha(int n, int k) { int h = 1 << (k - 1); return n >= 0 ? (n + h) >> k : -((h - n) >> k); }
uint rectSample(int tl, int ns, int nt, int shS) {
  if((R(R_FLAGS) & F_FILT) == 0) return fetch(tl, foldS(tl, ns >> shS), foldT(tl, nt >> 12));
  return sampleFilt(tl, rha(ns, shS - 5), rha(nt, 7));
