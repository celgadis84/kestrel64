      frac = (!sharpen && !detail) ? (distant ? 0xff : 0)
           : (max(int((U(R_TINFO) >> 8) & 0x1fu), maxd) << 3) + (sharpen ? -0x100 : 0);
    } else {
      int mipBase = findMSB(uint(maxd >> 5));
