}
int lodSelect(int s, int t, int sdx, int tdx, int sdy, int tdy, bool ovf, uint maxLevel,
              inout uint tile0, inout uint tile1) {
  uint ohi = U(R_OHI);
  bool lodEn = ((ohi >> 16) & 1u) != 0u, sharpen = ((ohi >> 17) & 1u) != 0u, detail = ((ohi >> 18) & 1u) != 0u;
  bool magnify = false, distant = false;
