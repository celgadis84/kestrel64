void perspDivide(int s, int t, int w, out int os, out int ot, inout bool ovf) {
  bool wCarry = w <= 0;
  w &= 0x7fff;
  int msb = findMSB(uint(w));
  int shift = min(14 - msb, 14);
  int normout = int(uint(w) << shift) & 0x3fff;
  int rcp = ((kPt1[normout >> 8] * (normout & 0xff)) >> 10) + kPt0[normout >> 8];
  int prod[2] = int[2](int(uint(s) * uint(rcp)), int(uint(t) * uint(rcp)));
  int outv2[2];
  int mask = ((1 << 30) - 1) & -((1 << 29) >> shift);
  for(int i = 0; i < 2; i++) {
    int oob = prod[i] & mask;
    int p = shift != 14 ? (prod[i] >> (13 - shift)) : prod[i];
    outv2[i] = shift != 14 ? p : int(uint(prod[i]) << 1);
    if(oob != mask && oob != 0) { outv2[i] = (p & (1 << 29)) == 0 ? 0x7fff : -0x8000; ovf = true; }
    if(wCarry) { outv2[i] = 0x7fff; ovf = true; }
    outv2[i] = clamp(outv2[i], -0x10000, 0xffff);
  }
