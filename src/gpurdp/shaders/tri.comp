    uint i = nib * 17u;
    return (i << 24) | (i << 16) | (i << 8) | i;
  }
  if(kind == TK_YUV) {
    uint off = (row + s * 2u) ^ ox;
    uint pairBase = (row + (s & ~1u) * 2u) ^ ox;
    if(pairBase + 2u >= 0x1000u || off + 1u >= 0x1000u) return 0u;
    int Y = int(tmB(off + 1u)), dU = int(tmB(pairBase)) - 128, dV = int(tmB(pairBase + 2u)) - 128;
    int k0 = R(R_K0), k1 = R(R_K0 + 1), k2 = R(R_K0 + 2), k3 = R(R_K0 + 3);
    uint r = uint(clamp(Y + ((k0 * dV + 0x40) >> 7), 0, 255));
    uint g = uint(clamp(Y + ((k1 * dU + k2 * dV + 0x40) >> 7), 0, 255));
    uint b = uint(clamp(Y + ((k3 * dU + 0x40) >> 7), 0, 255));
