    if(distant) off = maxLevel;
    if(!detail) {
      tile0 = (tile0 + off) & 7u;
      tile1 = (distant || (!sharpen && magnify)) ? tile0 : (tile0 + 1u) & 7u;
    } else {
      tile1 = (tile0 + off + ((distant || magnify) ? 1u : 2u)) & 7u;
      tile0 = (tile0 + off + (magnify ? 0u : 1u)) & 7u;
    }
  }
