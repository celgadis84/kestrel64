  else {
    int a0 = sdx - s, a1 = tdx - t, a2 = sdy - s, a3 = tdy - t;
    int maxd = max(max(a0 ^ (a0 >> 31), a1 ^ (a1 >> 31)), max(a2 ^ (a2 >> 31), a3 ^ (a3 >> 31)));
    if(maxd >= 0x4000) { distant = true; off = maxLevel; }
    else if(maxd < 32) {
