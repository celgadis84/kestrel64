  }
  if(kind == TK_IA16 || kind == TK_RGBA16) {
    uint off = (row + s * 2u) ^ ox;
    if(off + 1u >= 0x1000u) return 0u;
    uint px = (tmB(off) << 8) | tmB(off + 1u);
    if(kind == TK_IA16) { uint i = (px >> 8) & 0xffu, a = px & 0xffu;
