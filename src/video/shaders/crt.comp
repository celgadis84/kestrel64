#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

// Televisor de tubo, escrito para kestrel (sin codigo de terceros).
//
// Cada linea del invitado es un haz con perfil gaussiano en vertical; el pixel de salida
// suma las dos lineas mas cercanas. El haz engorda con el brillo (en un tubo real el punto
// crece con la corriente), asi que las zonas oscuras dejan ver la raya negra entre lineas y
// las claras casi la tapan. En horizontal se interpola lineal (la senal es analogica). Todo
// en luz lineal (gamma 2.2) y vuelta al final. Con escala >= 3 se anade una rejilla de
// apertura (franjas R/G/B por columna de salida); por debajo crearia moire, se omite.
// Sin curvatura: el N64 se ve en pantalla plana completa.
//   pc.param.x = intensidad de la rejilla (0..1)

vec3 lin(vec3 c) { return pow(max(c, 0.0), vec3(2.2)); }

vec3 rowColor(float row, float x) {
  float y = (clamp(row, 0.0, pc.inSize.y - 1.0) + 0.5) * pc.inSize.w;
  return lin(texture(t0, vec2(x, y)).rgb);
}

vec3 beam(vec3 c, float dist) {
  // anchura del haz en lineas: 0.30 en negro, 0.55 en blanco
  vec3 w = mix(vec3(0.30), vec3(0.55), sqrt(c));
  vec3 t = dist / w;
  return c * exp(-0.5 * t * t) / w;
}

void main() {
  ivec2 p;
  if(!outPixel(p)) return;
  vec2 uv = outUv(p);
  float ty = uv.y * pc.inSize.y - 0.5;
  float r0 = floor(ty);
  float f = ty - r0;
  vec3 a = rowColor(r0, uv.x);
  vec3 b = rowColor(r0 + 1.0, uv.x);
  // 0.4 = 1/sqrt(2*pi): normaliza la gaussiana para que un campo uniforme no cambie de brillo
  vec3 c = (beam(a, f) + beam(b, 1.0 - f)) * 0.4;

  float scale = pc.outSize.x * pc.inSize.z;
  if(scale >= 3.0) {
    int m = p.x % 3;
    vec3 mask = vec3(m == 0 ? 1.0 : 0.0, m == 1 ? 1.0 : 0.0, m == 2 ? 1.0 : 0.0);
    float k = pc.param.x;
    // la rejilla quita 2/3 de la luz por canal; se compensa para que el brillo medio quede
    c *= mix(vec3(1.0), mask * 3.0, k * 0.5);
  }
  c = pow(clamp(c, 0.0, 1.0), vec3(1.0 / 2.2));
  imageStore(outImg, p, vec4(c, 1.0));
}
