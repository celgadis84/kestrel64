#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

// Estetica de dibujo animado (cel-shading de posproceso), escrito para kestrel.
//
// Un cel-shading de verdad cuantiza la ILUMINACION, y aqui solo hay la imagen ya iluminada;
// lo que se puede hacer sin tocar el juego es lo mismo que hacen los filtros "toon" de
// imagen: (1) cuantizar la luminancia en pocas bandas conservando el tono, con un borde
// suave entre bandas para que el degradado de Gouraud no se convierta en rayas de un pixel
// que bailan; y (2) trazar contornos donde la imagen cambia de golpe (Sobel sobre luminancia
// y color), que en un juego 3D coinciden casi siempre con siluetas y aristas.
//
//   t0 = imagen ya escalada (EASU) y aplanada (Kuwahara de radio 1) a la resolucion de
//        salida: de ahi sale el color. El aplanado quita el grano de las texturas, que si no
//        se convierte en manchas al cuantizar
//   t1 = cuadro original del invitado: de ahi salen los bordes. Las muestras van a 1,5
//        texeles, entre dos texeles, y el filtro lineal las promedia: Sobel sobre una imagen
//        ligeramente suavizada, que no traza el ruido de la textura. El paso va en texeles
//        del invitado para que el grosor del trazo no dependa del tamano de la ventana
//   pc.param.x = numero de bandas (por defecto 5)
//   pc.param.y = umbral del contorno (por defecto 0.45)
//   pc.param.z = saturacion extra (por defecto 1.15)

vec3 srcAt(vec2 uv, vec2 o) { return texture(t1, uv + o * 1.5 * pc.srcSize.zw).rgb; }

float edge(vec2 uv) {
  vec3 tl = srcAt(uv, vec2(-1, -1)), tc = srcAt(uv, vec2(0, -1)), tr = srcAt(uv, vec2(1, -1));
  vec3 ml = srcAt(uv, vec2(-1,  0)),                               mr = srcAt(uv, vec2(1,  0));
  vec3 bl = srcAt(uv, vec2(-1,  1)), bc = srcAt(uv, vec2(0,  1)), br = srcAt(uv, vec2(1,  1));
  vec3 gx = (tr + 2.0 * mr + br) - (tl + 2.0 * ml + bl);
  vec3 gy = (bl + 2.0 * bc + br) - (tl + 2.0 * tc + tr);
  // luminancia sobre todo; el color cuenta a medias, para que dos superficies de igual
  // brillo y distinto color tambien tengan silueta sin que cada cambio de tono sea un trazo
  vec3 g = sqrt(gx * gx + gy * gy);
  float gl = abs(luma(g));
  return max(gl, 0.5 * max(g.r, max(g.g, g.b)));
}

void main() {
  ivec2 p;
  if(!outPixel(p)) return;
  vec2 uv = outUv(p);
  vec3 c = texture(t0, uv).rgb;
  float levels = max(pc.param.x, 2.0);
  float thr = pc.param.y;

  float l = luma(c);
  float x = l * levels;
  float band = floor(x);
  // borde de banda suavizado en un 20 % de su anchura
  float q = (band + smoothstep(0.4, 0.6, fract(x))) / levels;
  q = clamp(q + 0.5 / levels, 0.0, 1.0);
  vec3 tone = l > 1e-4 ? c * (q / l) : vec3(q);
  vec3 grey = vec3(luma(tone));
  tone = clamp(grey + (tone - grey) * pc.param.z, 0.0, 1.0);

  float e = edge(uv);
  float ink = smoothstep(thr, thr * 2.0, e);
  vec3 outC = mix(tone, tone * 0.2, ink);
  imageStore(outImg, p, vec4(outC, 1.0));
}
