#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

// AMD FidelityFX Super Resolution 1.0 -- RCAS (Robust Contrast Adaptive Sharpening).
// Adaptado de ffx_fsr1.h (FsrRcasF, version de 32 bits), Copyright (c) 2021 Advanced Micro
// Devices, Inc., licencia MIT (texto en THIRD-PARTY.txt).
//
// Enfoque de cruz 3x3 cuyo lobulo negativo se limita para no salirse del rango de los
// vecinos: devuelve la nitidez que el escalado se come sin halos ni ruido.
// pc.param.x = nitidez en "paradas" (0 = maxima, cada +1 la reduce a la mitad).
// La entrada t0 es del MISMO tamano que la salida.

#define FSR_RCAS_LIMIT (0.25 - (1.0 / 16.0))

vec3 rcasLoad(ivec2 p) {
  p = clamp(p, ivec2(0), ivec2(pc.inSize.xy) - 1);
  return texelFetch(t0, p, 0).rgb;
}

void main() {
  ivec2 ip;
  if(!outPixel(ip)) return;
  float sharp = exp2(-pc.param.x);
  vec3 b = rcasLoad(ip + ivec2( 0, -1));
  vec3 d = rcasLoad(ip + ivec2(-1,  0));
  vec3 e = rcasLoad(ip);
  vec3 f = rcasLoad(ip + ivec2( 1,  0));
  vec3 h = rcasLoad(ip + ivec2( 0,  1));
  vec3 mn4 = min(min(b, d), min(f, h));
  vec3 mx4 = max(max(b, d), max(f, h));
  vec2 peakC = vec2(1.0, -4.0);
  vec3 hitMin = min(mn4, e) / (4.0 * mx4 + 1e-6);
  vec3 hitMax = (peakC.x - max(mx4, e)) / (4.0 * mn4 + peakC.y);
  vec3 lobeRGB = max(-hitMin, hitMax);
  float lobe = max(-FSR_RCAS_LIMIT, min(max(lobeRGB.r, max(lobeRGB.g, lobeRGB.b)), 0.0)) * sharp;
  float rcpL = 1.0 / (4.0 * lobe + 1.0);
  vec3 pix = (lobe * (b + d + h + f) + e) * rcpL;
  imageStore(outImg, ip, vec4(clamp(pix, 0.0, 1.0), 1.0));
}
